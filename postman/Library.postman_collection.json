{
  "info": {
    "_postman_id": "3b7e9c41-6a2d-4f8e-b1c5-7d9a0e2f4c68",
    "name": "Biblioteca Universitaria - Members",
    "description": "Colección de la API de socios (variante B) con PostgreSQL y pg.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Members",
      "item": [
        {
          "name": "Crear socio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const member = pm.response.json();",
                  "pm.test(\"Devuelve el socio con id y activo por defecto\", () => {",
                  "  pm.expect(member.id).to.be.a(\"number\");",
                  "  pm.expect(member.active).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set(\"memberId\", member.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lucía Mendoza\",\n  \"email\": \"lucia.mendoza@correo.com\",\n  \"membershipType\": \"estudiante\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ]
            }
          }
        },
        {
          "name": "Listar socios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ]
            }
          }
        },
        {
          "name": "Ver socio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve el socio solicitado\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"memberId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}"
              ]
            }
          }
        },
        {
          "name": "Crear socio inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Mensaje en español\", () => pm.expect(pm.response.json().error).to.eql(\"El tipo de membresía no es válido\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lucía Mendoza\",\n  \"email\": \"lucia.mendoza@correo.com\",\n  \"membershipType\": \"administrativo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ]
            }
          }
        },
        {
          "name": "Ver socio inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Mensaje en español\", () => pm.expect(pm.response.json().error).to.eql(\"Socio no encontrado\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "999999"
              ]
            }
          }
        },
        {
          "name": "Desactivar socio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El socio queda inactivo\", () => pm.expect(pm.response.json().active).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "deactivate"
              ]
            }
          }
        },
        {
          "name": "Desactivar socio inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Mensaje en español\", () => pm.expect(pm.response.json().error).to.eql(\"Socio no encontrado\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/999999/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "999999",
                "deactivate"
              ]
            }
          }
        }
      ]
    }
  ]
}
